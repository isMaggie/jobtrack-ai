# Copy development setting to .env.local and test setting to .env.test.local.
# Replace role and password with your local PostgreSQL account.
DATABASE_URL=postgresql://jobtrack:password@localhost:5432/jobtrack_ai
TEST_DATABASE_URL=postgresql://jobtrack:password@localhost:5432/jobtrack_ai_test

# Server-only key for confirmation-email extraction. Never use NEXT_PUBLIC_.
OPENAI_API_KEY=

# Required in production. Browser username: jobtrack. Use a long random password.
# Optional locally; never prefix with NEXT_PUBLIC_.
APP_ACCESS_PASSWORD=

# Google OAuth web client; register this exact callback URL in Google Cloud.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/gmail/callback
# Generate once with: openssl rand -base64 32. Keep stable and server-only.
GMAIL_TOKEN_KEY=
